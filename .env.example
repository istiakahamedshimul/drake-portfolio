# ==============================================================================
# Drake Portfolio - Environment Variables Template
# Copy this file to .env.local for local development.
# For Vercel deployment: Add these 4 variables in Vercel -> Project Settings -> Environment Variables.
# NEVER commit .env.local or your actual secret keys to Git!
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (Safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (Server-side ONLY - bypasses RLS for Admin operations)
# DO NOT EXPOSE TO BROWSER / CLIENT
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Portal Passcode (Used to log into /admin)
# Defaults to 'drake2024' if not set, but recommended to set a custom secure password
ADMIN_PASSWORD=drake2024
